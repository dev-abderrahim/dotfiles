# Config generated by Ghostty Config

title = Ghostty
maximize = true
working-directory = $HOME
title-report = true
scrollback-limit = 20000
bell-features = no-audio,border
window-theme = ghostty
cursor-style=block
adjust-cursor-thickness=3
cursor-style-blink=true
shell-integration-features = no-cursor,sudo,ssh-env,ssh-terminfo
theme = Ubuntu
bold-color = bright
#background = #0e1019
#foreground = #fffaf4
#selection-background = #002a3b
#selection-foreground = #ffffff
#cursor-color = #ff0018
#cursor-text = #ff8ca4
#palette = 0=#484f58
#palette = 1=#ff7b72
#palette = 2=#3fb950
#palette = 3=#d29922
#palette = 4=#58a6ff
#palette = 5=#bc8cff
#palette = 6=#39c5cf
#palette = 7=#b1bac4
#palette = 8=#6e7681
#palette = 9=#ffa198
#palette = 10=#56d364
#palette = 11=#e3b341
#palette = 12=#79c0ff
#palette = 13=#d2a8ff
#palette = 14=#56d4dd
#palette = 15=#ffffff
font-size = 10
font-family = JetBrainsMono NF
mouse-hide-while-typing = true
focus-follows-mouse = true
