# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# -- Shell options ------------------------------------------------------------
setopt COMPLETE_IN_WORD    # Complete from both ends of the word
setopt ALWAYS_TO_END       # Place cursor at end of word after completing
setopt AUTO_MENU           # Show completion menu on successive <Tab>
setopt AUTO_CD             # Cd by typing directory name without cd
setopt NO_BEEP             # Disable audible bell

# -- History ------------------------------------------------------------------
HISTFILE=~/.zsh_history    # History database file
HISTSIZE=100000            # Events kept in memory per session
SAVEHIST=100000            # Events written to HISTFILE on exit

setopt SHARE_HISTORY       # Share history across all running sessions
setopt EXTENDED_HISTORY    # Record timestamps and duration with each entry
setopt INC_APPEND_HISTORY  # Append immediately, not just on shell exit

# -- Oh My Zsh ----------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

zstyle ':omz:update' mode disabled   # Disable auto-updates; update manually

DISABLE_MAGIC_FUNCTIONS="true"       # Don't auto-escape pasted URLs
COMPLETION_WAITING_DOTS="true"       # Show "..." while completions are generated

plugins=(
    git                      # Git aliases and prompt status
    direnv                   # Auto-load environment from .envrc
    #zsh-autosuggestions     # Fish-like inline suggestions
    #zsh-syntax-highlighting # Realtime syntax highlight
)

source $ZSH/oh-my-zsh.sh

# -- Key bindings -------------------------------------------------------------
bindkey -e                 # Emacs-style key bindings (default)

# -- mise (dev tool version manager) -------------------------------------------
# Activate shims and shell hooks
command -v mise &>/dev/null && eval "$(mise activate zsh)"

# -- Aliases ------------------------------------------------------------------
alias l='ls'
alias ll='ls -lah'
alias la='ls -A'

# -- Local overrides ----------------------------------------------------------
# Machine-specific settings that shouldn't be in a shared dotfiles repo.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# -- Powerlevel10k theme config -----------------------------------------------
# Generated by `p10k configure` — customise your prompt there.
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
